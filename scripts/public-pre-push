#!/usr/bin/env bash
# pre-push-Hook fuer den oeffentlichen Spiegel (seit 2026-11-04).
# Prueft jeden Commit, der gepusht wird, mit scripts/privacy-check.py - auch
# bei einem direkten "git push" am publish-public.sh vorbei. Bei einem Treffer
# bricht der Push ab. Eingerichtet von publish-public.sh als Symlink
# <Spiegel>/.git/hooks/pre-push -> <Polaris-Repo>/scripts/public-pre-push.
# Umgehen nur mit Nutzerfreigabe: git push --no-verify.
set -euo pipefail
CHECK="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/privacy-check.py"
[ -f "$CHECK" ] || { echo "pre-push: $CHECK fehlt - Push abgebrochen." >&2; exit 1; }

ZERO=0000000000000000000000000000000000000000
work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT
fail=0 dirs=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                # Loeschen eines Zweigs
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha"                                   # neuer Zweig: alle Commits
  else
    range="$remote_sha..$local_sha"
  fi
  for sha in $(git rev-list "$range"); do
    # Inhalt und Metadaten (Autor, Committer, Nachricht) sind oeffentlich.
    c="$work/${sha:0:12}" m="$work/${sha:0:12}-meta"
    mkdir -p "$c" "$m"
    git archive "$sha" | tar -C "$c" -xf -
    git log -1 --format='%an <%ae>%n%cn <%ce>%n%B' "$sha" > "$m/commit.txt"
    dirs+=("$c" "$m")
  done
done
# Ein Aufruf fuer alle Commits: der geschuetzte Ordner wird nur einmal gelesen.
if [ "${#dirs[@]}" -gt 0 ] && ! python3 "$CHECK" "${dirs[@]}"; then
  echo "pre-push: private Inhalte oder Angaben in Autor/Nachricht (siehe oben; Ordnername = Commit) - Push abgebrochen." >&2
  fail=1
fi
exit "$fail"
